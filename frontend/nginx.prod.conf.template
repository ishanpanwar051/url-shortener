resolver 8.8.8.8 valid=30s;

server {
    listen 80;
    server_name _;
    client_max_body_size 10M;

    # Security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy "strict-origin-when-cross-origin";

    set $backend "${BACKEND_URL}";

    # API endpoints → proxy to backend
    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Health check → proxy to backend
    location /health {
        proxy_pass $backend;
        proxy_set_header Host $proxy_host;
    }

    # Static assets with long cache
    location /static/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        gzip on;
        gzip_types application/javascript text/css;
    }

    # Known SPA routes — serve frontend index.html (must be before short-code catch-all)
    location ~ ^/(login|register|dashboard|analytics) {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # Short code redirects — proxy to backend
    location ~ ^/[a-zA-Z0-9_-]+$ {
        proxy_pass $backend;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
