modules = ["nodejs-20", "bash"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3003

[[ports]]
localPort = 6379
externalPort = 3000
exposeLocalhost = true

[userenv]

[userenv.shared]
CORS_ORIGIN = "*"
NODE_ENV = "development"
REDIS_URL = "redis://localhost:6379"

[userenv.production]
PORT = "3000"
SERVE_STATIC = "true"

[deployment]
deploymentTarget = "vm"
run = ["bash", "start-prod.sh"]
