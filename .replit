modules = ["nodejs-20", "bash", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"
waitForPort = 3000

[[ports]]
localPort = 3000
externalPort = 80

[userenv]

[userenv.shared]
CORS_ORIGIN = "*"
NODE_ENV = "development"
REDIS_URL = "redis://localhost:6379"
