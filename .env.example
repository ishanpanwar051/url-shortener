# Database — use 'localhost' for local dev, 'postgres' for Docker
DATABASE_URL=postgresql://user:password@localhost:5432/urlshortener
REPLICA_DATABASE_URL=

# Redis
# Redis — use 'localhost' for local dev, 'redis' for Docker
REDIS_URL=redis://localhost:6379

# JWT — Generate a secure random key (minimum 32 characters)
# Linux/macOS: openssl rand -base64 48
# Windows: Use PowerShell: [Convert]::ToBase64String((1..64|%{Get-Random -Max 256}))
JWT_SECRET=change-this-to-a-secure-random-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_DOMAIN=
NODE_ENV=development

# CORS — Required in production (e.g. https://yourdomain.com)
# Docker frontend: http://localhost:8080 | CRA dev server: http://localhost:3000
CORS_ORIGIN=http://localhost:8080

# Public URL used in QR codes and short links (optional — auto-detected from request headers)
PUBLIC_BASE_URL=http://localhost:8080

# Server
PORT=3000
MACHINE_ID=1

# DSA Parameters
BLOOM_FILTER_EXPECTED=1000000
BLOOM_FILTER_FPR=0.01
LRU_CACHE_CAPACITY=10000
RATE_LIMIT_PER_MINUTE=60
SHORT_CODE_LENGTH=7
DEFAULT_URL_EXPIRY_DAYS=365
